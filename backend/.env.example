# CryoSync self-hosted configuration (no Databricks)

# --- Directory ---
# Where the SQLite database file lives (default: ./cryosync.db in backend/).
# CRYOSYNC_DB_PATH=backend/cryosync.db

# --- OpenAI-compatible AI (agent chat + document extraction) ---
# Any OpenAI-compatible provider works (OpenAI, Together, OpenRouter, a local
# vLLM/Ollama server, etc.). Leave OPENAI_API_KEY empty to run without AI
# (the Kyra agent and AI Extract pages will show a configuration error).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Vision-capable model for AI document extraction (/api/ai/extract-form).
# Use a multimodal model, e.g. gpt-4o-mini, gpt-4o, or a local VLM.
# OPENAI_VISION_MODEL=gpt-4o-mini
#
# On Databricks model serving the endpoint is chosen by the URL, not the
# `model` field, so a vision endpoint needs its own base URL. Example:
#   OPENAI_VISION_BASE_URL=<host>/serving-endpoints/<vision_endpoint>/invocations
# OPENAI_VISION_BASE_URL=

# --- Databricks Genie space (natural-language data Q&A for the Kyra agent) ---
# If GENIE_SPACE_ID is set, Kyra can answer data questions by delegating to a
# real Databricks Genie space. Requires DATABRICKS_HOST and DATABRICKS_TOKEN
# (the ones used by the SQLite->Databricks migration tooling). Find the space
# id via the Genie space URL or GET /api/2.0/genie/spaces. Leave empty to
# disable Genie-backed questions.
GENIE_SPACE_ID=

# --- Automatic temperature-incident detection ---
# How often the background scanner checks shipments for temperature excursions
# and auto-reports new incidents, in minutes (default 1). Set to 0 to disable.
# AI_SCAN_INTERVAL_MINUTES=1

# How long (hours) an existing temperature-excursion incident for a shipment
# suppresses re-reporting the same excursion (default 168, i.e. 7 days).
# TEMPERATURE_INCIDENT_REPORT_WINDOW_HOURS=168
