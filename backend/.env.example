# Databricks credentials
# Workspace host, e.g. https://<workspace-id>.cloud.databricks.com
DATABRICKS_HOST=your_workspace_host_here

# --- Option A (simple): static token ---
# Personal access token (PAT) or a fresh OAuth token. PATs don't expire by
# default; OAuth M2M tokens expire after 1 hour and must be re-generated
# manually. Create a PAT at https://<your-workspace>/settings/user/access-tokens
# DATABRICKS_TOKEN=dapi51c16c32c819c3453d252c2dcd3b04d0

# --- Option B (recommended): automatic OAuth token refresh ---
# Set these instead of DATABRICKS_TOKEN and the backend fetches and refreshes
# the OAuth token automatically, so you never have to rotate it by hand.
# Create a service principal + OAuth secret in your Databricks account console,
# then set:
# DATABRICKS_CLIENT_ID=your_service_principal_oauth_client_id
# DATABRICKS_CLIENT_SECRET=your_service_principal_oauth_client_secret

# Serving endpoint name for the foundation model to use (foundation model
# API endpoints are prefixed databricks-, e.g. databricks-meta-llama-3-3-70b-instruct)
DATABRICKS_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# OpenAI-compatible base URL for Databricks Model Serving
# (defaults to https://<DATABRICKS_HOST>/serving-endpoints)
# DATABRICKS_BASE_URL=https://your-workspace.cloud.databricks.com/serving-endpoints

# --- Databricks Lakebase Postgres (CryoSync database) ---
# The DB authenticates with a short-lived (1h) Databricks database credential.
# The backend now mints a fresh credential automatically (using the same
# DATABRICKS_TOKEN / M2M OAuth setup above) and rebuilds the connection pool
# before expiry, so no manual JWT rotation is ever needed.
DATABRICKS_DB_HOST=ep-bitter-frog-d8048hup.database.us-east-2.cloud.databricks.com
# DATABRICKS_DB_PORT=5432
# DATABRICKS_DB_NAME=proreactapp
# DATABRICKS_DB_USER=thasneem.moosa@abilytics.com
# Full Lakebase endpoint resource name (from the Connect dialog in the
# Lakebase console). When empty it is auto-discovered from the /api/2.0/postgres
# API by matching DATABRICKS_DB_HOST.
DATABRICKS_DB_ENDPOINT=projects/proreact/branches/production/endpoints/primary
# If set, skips token minting and uses this as a permanent DB password instead.
# DATABRICKS_DB_PASSWORD=

# Automatic temperature-incident detection
# How often the background scanner checks shipments for temperature excursions
# and auto-reports new incidents, in minutes (default 1). Set to 0 to disable.
# AI_SCAN_INTERVAL_MINUTES=1

# How long (hours) an existing temperature-excursion incident for a shipment
# suppresses re-reporting the same excursion - regardless of whether the incident
# is open, resolved, or closed. Prevents the scanner from re-creating incidents
# in a loop after they are resolved (default 168, i.e. 7 days). Set to 0 to
# re-report immediately after resolution.
# TEMPERATURE_INCIDENT_REPORT_WINDOW_HOURS=168
